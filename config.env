#!/usr/bin/env bash
# Central config for the AxionOS coral build pipeline.
# Edit these if you fork this for a different device or branch.

# --- Source tree ---
export SOURCE_ROOT="${SOURCE_ROOT:-$HOME/axionos}"
export MANIFEST_URL="https://github.com/AxionAOSP/android.git"
export MANIFEST_BRANCH="lineage-23.2"

# --- Device ---
export DEVICE_CODENAME="coral"
export DEVICE_TREE_URL="https://github.com/LineageOS/android_device_google_coral.git"
export DEVICE_TREE_PATH="device/google/coral"
export KERNEL_TREE_URL="https://github.com/LineageOS/android_kernel_google_msm-4.14.git"
export KERNEL_TREE_PATH="kernel/google/msm-4.14"
export VENDOR_TREE_URL="https://github.com/TheMuppets/proprietary_vendor_google_coral.git"
export VENDOR_TREE_PATH="vendor/google/coral"
# Branch fallback order to try in turn if MANIFEST_BRANCH isn't available
# for a given repo (coral is unofficial for Axion, so mirrors may lag).
# lineage-23.2 tried first since that's AxionOS's current branch; older
# entries kept as fallbacks in case the device/kernel/vendor trees haven't
# caught up yet (coral has no official Axion maintainer).
export BRANCH_FALLBACKS=("lineage-23.2" "lineage-22.2" "lineage-22.1" "lineage-22.0")

# --- KernelSU-Next + SUSFS ---
# RESOLVED: the wlan0-never-registers symptom that briefly looked shared
# between KSU-Next and ReSukiSU was NOT a root-framework bug at all -- it
# was "wlan: disagrees about version of symbol module_layout" from only
# ever flashing boot.img and never re-flashing vendor.img/vendor_dlkm.img,
# so the freshly-built kernel modules on /vendor never matched the new
# kernel. Sideloading the full ROM zip (which flashes vendor partitions
# too) fixed it on both a stock build and a KSU-Next+SUSFS build. Always
# flash/sideload the full package now, not just boot.img.
#
# This default is "false" -- builds are stock/non-rooted unless you opt
# in. 04-ksu-susfs.sh will prompt interactively (y/N) when run without a
# --yes/--no flag, so this value is really just the fallback for a
# non-interactive run that doesn't pass either flag.
export INTEGRATE_KSU_SUSFS="false"
export KSU_SETUP_URL="https://raw.githubusercontent.com/rifsxd/KernelSU-Next/next/kernel/setup.sh"
export KSU_VERSION="v1.1.1"
export SUSFS_PATCH_URL="https://github.com/sidex15/KernelSU-Next/commit/1e750de25930e875612bbec0410de0088474c00b.patch"
export SUSFS_REPO_URL="https://gitlab.com/simonpunk/susfs4ksu.git"
export SUSFS_KERNEL_BRANCH="kernel-4.14"

# --- Keys ---
export KEYS_BACKUP_DIR="${KEYS_BACKUP_DIR:-$HOME/keys-backup}"

# --- Build variant (Google apps) ---
# One of: gms/full (full GMS), pico (minimal GMS), core (core GMS),
# va/vanilla (no Google apps at all). Change this to switch Gapps on/off.
export GMS_VARIANT="core"

# --- AxionOS "About phone" device properties ---
# Written into the device tree's product makefile by 07-device-properties.sh.
# Underscores become spaces in the AxionOS "About phone" UI.
export AXION_MAINTAINER="Hecker"
export AXION_CAMERA_REAR_INFO="12,16"      # adjust to coral's actual sensor specs
export AXION_CAMERA_FRONT_INFO="8"
export AXION_PROCESSOR="Snapdragon_855"
